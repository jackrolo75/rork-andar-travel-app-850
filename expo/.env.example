# ===========================================
# AndarTravel — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets.

# --- Feature Flags ---
REACT_APP_FEATURE_ACTIVITIES_ENABLED=false

# --- Travelpayouts / Affiliate ---
TP_BASE_URL=https://tp.media/r?marker=581079&trs=364656&p=2074&u=https%3A%2F%2Ftiqets.com&campaign_id=89

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Redis ---
REDIS_URL=

# --- Rork Platform (set automatically) ---
EXPO_PUBLIC_RORK_DB_ENDPOINT=
EXPO_PUBLIC_RORK_DB_NAMESPACE=
EXPO_PUBLIC_RORK_DB_TOKEN=
EXPO_PUBLIC_RORK_API_BASE_URL=
EXPO_PUBLIC_RORK_AUTH_URL=
EXPO_PUBLIC_TOOLKIT_URL=
EXPO_PUBLIC_PROJECT_ID=
EXPO_PUBLIC_TEAM_ID=
